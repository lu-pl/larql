// =============================================================================
// SPARQL 1.2 Query and Update Lark Grammar for `larql`
//
// Sources:
//   - SPARQL 1.2 Query Language, Grammar: https://www.w3.org/TR/sparql12-query/#sparqlGrammar
//   - SPARQL 1.2 Query Language, sparql.bnf: https://www.w3.org/TR/sparql12-query/sparql.bnf
//
// Every grammar production [1]-[194] is translated in spec order.
// The respective W3C BNF production rule is quoted in a comment directly above its Lark translation.
//
// The `larql` SPARQL 1.2 grammar intentionally avoids tree shaping and aims to be faithful to the BNF production spec.
// There are no ?rule, !rule or _rule modifiers, no aliases (->) and no helper rules.
// Each spec production becomes exactly one tree node.
// Shaping the tree is left to Transformers that build the AST.
//
// Use with: Lark(grammar, parser="lalr", lexer="basic", keep_all_tokens=True):
//
//   - keep_all_tokens=True keeps keywords and punctuation in the tree;
//     without it, anonymous tokens like "DISTINCT"i or "(" are dropped,
//     breaking the no-grammar-shaping guarantee above.
//
//   - lexer="basic" tokenizes without looking at parser state,
//     matching the spec's context-independent "longest match" rule (grammar note 3).
//
//
// Deliberate deviations from the mechanical translation, each marked "SPEC DEVIATION" where it occurs:
//
//   - [40] [41] [42]: 'INSERT DATA', 'DELETE DATA' and 'DELETE WHERE' are split into two keywords each.
//
//   - Terminals: Priorities (.1, .2) reproduce "longest match" where two terminals can match the same input
//                and regexes are used for the spec's "anything except" classes.
//                Both cases are explained in the terminals section.
//
// =============================================================================


// Top-level entry point
start: query_unit | update_unit


// =============================================================================
// Query structure: prologue, query forms, solution modifiers  [1]-[30]
// =============================================================================

// [1] QueryUnit ::= Query
query_unit: query

// [2] Query ::= Prologue ( SelectQuery | ConstructQuery | DescribeQuery | AskQuery ) ValuesClause
query: prologue (select_query | construct_query | describe_query | ask_query) values_clause

// [3] UpdateUnit ::= Update
update_unit: update

// [4] Prologue ::= ( BaseDecl | PrefixDecl | VersionDecl )*
prologue: (base_decl | prefix_decl | version_decl)*

// [5] BaseDecl ::= 'BASE' IRIREF
base_decl: "BASE"i IRIREF

// [6] PrefixDecl ::= 'PREFIX' PNAME_NS IRIREF
prefix_decl: "PREFIX"i PNAME_NS IRIREF

// [7] VersionDecl ::= 'VERSION' VersionSpecifier
version_decl: "VERSION"i version_specifier

// [8] VersionSpecifier ::= STRING_LITERAL1 | STRING_LITERAL2
version_specifier: STRING_LITERAL1 | STRING_LITERAL2

// [9] SelectQuery ::= SelectClause DatasetClause* WhereClause SolutionModifier
select_query: select_clause dataset_clause* where_clause solution_modifier

// [10] SubSelect ::= SelectClause WhereClause SolutionModifier ValuesClause
sub_select: select_clause where_clause solution_modifier values_clause

// [11] SelectClause ::= 'SELECT' ( 'DISTINCT' | 'REDUCED' )? ( ( Var | ( '(' Expression 'AS' Var ')' ) )+ | '*' )
select_clause: "SELECT"i ("DISTINCT"i | "REDUCED"i)? ((var | ("(" expression "AS"i var ")"))+ | "*")

// [12] ConstructQuery ::= 'CONSTRUCT' ( ConstructTemplate DatasetClause* WhereClause SolutionModifier | DatasetClause* 'WHERE' ConstructTemplate SolutionModifier )
construct_query: "CONSTRUCT"i (construct_template dataset_clause* where_clause solution_modifier
               | dataset_clause* "WHERE"i construct_template solution_modifier)

// [13] DescribeQuery ::= 'DESCRIBE' ( VarOrIri+ | '*' ) DatasetClause* WhereClause? SolutionModifier
describe_query: "DESCRIBE"i (var_or_iri+ | "*") dataset_clause* where_clause? solution_modifier

// [14] AskQuery ::= 'ASK' DatasetClause* WhereClause SolutionModifier
ask_query: "ASK"i dataset_clause* where_clause solution_modifier

// [15] DatasetClause ::= 'FROM' ( DefaultGraphClause | NamedGraphClause )
dataset_clause: "FROM"i (default_graph_clause | named_graph_clause)

// [16] DefaultGraphClause ::= SourceSelector
default_graph_clause: source_selector

// [17] NamedGraphClause ::= 'NAMED' SourceSelector
named_graph_clause: "NAMED"i source_selector

// [18] SourceSelector ::= iri
source_selector: iri

// [19] WhereClause ::= 'WHERE'? GroupGraphPattern
where_clause: "WHERE"i? group_graph_pattern

// [20] SolutionModifier ::= GroupClause? HavingClause? OrderClause? LimitOffsetClauses?
solution_modifier: group_clause? having_clause? order_clause? limit_offset_clauses?

// [21] GroupClause ::= 'GROUP' 'BY' GroupCondition+
group_clause: "GROUP"i "BY"i group_condition+

// [22] GroupCondition ::= BuiltInCall | FunctionCall | '(' Expression ( 'AS' Var )? ')' | Var
group_condition: built_in_call | function_call | "(" expression ("AS"i var)? ")" | var

// [23] HavingClause ::= 'HAVING' HavingCondition+
having_clause: "HAVING"i having_condition+

// [24] HavingCondition ::= Constraint
having_condition: constraint

// [25] OrderClause ::= 'ORDER' 'BY' OrderCondition+
order_clause: "ORDER"i "BY"i order_condition+

// [26] OrderCondition ::=  ( ( 'ASC' | 'DESC' ) BrackettedExpression ) | ( Constraint | Var )
order_condition: (("ASC"i | "DESC"i) bracketted_expression) | (constraint | var)

// [27] LimitOffsetClauses ::= LimitClause OffsetClause? | OffsetClause LimitClause?
limit_offset_clauses: limit_clause offset_clause? | offset_clause limit_clause?

// [28] LimitClause ::= 'LIMIT' INTEGER
limit_clause: "LIMIT"i INTEGER

// [29] OffsetClause ::= 'OFFSET' INTEGER
offset_clause: "OFFSET"i INTEGER

// [30] ValuesClause ::= ( 'VALUES' DataBlock )?
values_clause: ("VALUES"i data_block)?


// =============================================================================
// Update  [31]-[54]
// =============================================================================

// [31] Update ::= Prologue ( Update1 ( ';' Update )? )?
update: prologue (update1 (";" update)?)?

// [32] Update1 ::= Load | Clear | Drop | Add | Move | Copy | Create | DeleteWhere | Modify | InsertData | DeleteData
update1: load
       | clear
       | drop
       | add
       | move
       | copy
       | create
       | delete_where
       | modify
       | insert_data
       | delete_data

// [33] Load ::= 'LOAD' 'SILENT'? iri ( 'INTO' GraphRef )?
load: "LOAD"i "SILENT"i? iri ("INTO"i graph_ref)?

// [34] Clear ::= 'CLEAR' 'SILENT'? GraphRefAll
clear: "CLEAR"i "SILENT"i? graph_ref_all

// [35] Drop ::= 'DROP' 'SILENT'? GraphRefAll
drop: "DROP"i "SILENT"i? graph_ref_all

// [36] Create ::= 'CREATE' 'SILENT'? GraphRef
create: "CREATE"i "SILENT"i? graph_ref

// [37] Add ::= 'ADD' 'SILENT'? GraphOrDefault 'TO' GraphOrDefault
add: "ADD"i "SILENT"i? graph_or_default "TO"i graph_or_default

// [38] Move ::= 'MOVE' 'SILENT'? GraphOrDefault 'TO' GraphOrDefault
move: "MOVE"i "SILENT"i? graph_or_default "TO"i graph_or_default

// [39] Copy ::= 'COPY' 'SILENT'? GraphOrDefault 'TO' GraphOrDefault
copy: "COPY"i "SILENT"i? graph_or_default "TO"i graph_or_default

// [40] InsertData ::= 'INSERT DATA' QuadData
// SPEC DEVIATION (19.7 Grammar, Notes, 5):
// The spec defines 'INSERT DATA' as a single token purely for readability;
// Note 5 in 19.7 allows any amount of white space between the two keywords.
// Writing two terminals in the Lark representation reproduces that directly,
// since %ignore already skips white space between any two tokens.
// Note that the W3C SPARQL 1.1 tests syntax-update-26 and syntax-update-36
// also test for the case of a comment appearing between the two keywords;
// those cases are also covered by the `larql` grammar through its %ignore rules.
// Same reasoning for [41] and [42].
insert_data: "INSERT"i "DATA"i quad_data

// [41] DeleteData ::= 'DELETE DATA' QuadData
// SPEC DEVIATION (19.7 Grammar, Notes, 5):
// Same reasoning as [40].
delete_data: "DELETE"i "DATA"i quad_data

// [42] DeleteWhere ::= 'DELETE WHERE' QuadPattern
// SPEC DEVIATION (19.7 Grammar, Notes, 5):
// Same reasoning as [40].
delete_where: "DELETE"i "WHERE"i quad_pattern

// [43] Modify ::= ( 'WITH' iri )? ( DeleteClause InsertClause? | InsertClause ) UsingClause* 'WHERE' GroupGraphPattern
modify: ("WITH"i iri)? (delete_clause insert_clause?
      | insert_clause) using_clause* "WHERE"i group_graph_pattern

// [44] DeleteClause ::= 'DELETE' QuadPattern
delete_clause: "DELETE"i quad_pattern

// [45] InsertClause ::= 'INSERT' QuadPattern
insert_clause: "INSERT"i quad_pattern

// [46] UsingClause ::= 'USING' ( iri | 'NAMED' iri )
using_clause: "USING"i (iri | "NAMED"i iri)

// [47] GraphOrDefault ::= 'DEFAULT' | 'GRAPH'? iri
graph_or_default: "DEFAULT"i | "GRAPH"i? iri

// [48] GraphRef ::= 'GRAPH' iri
graph_ref: "GRAPH"i iri

// [49] GraphRefAll ::= GraphRef | 'DEFAULT' | 'NAMED' | 'ALL'
graph_ref_all: graph_ref | "DEFAULT"i | "NAMED"i | "ALL"i

// [50] QuadPattern ::= '{' Quads '}'
quad_pattern: "{" quads "}"

// [51] QuadData ::= '{' Quads '}'
quad_data: "{" quads "}"

// [52] Quads ::= TriplesTemplate? ( QuadsNotTriples '.'? TriplesTemplate? )*
quads: triples_template? (quads_not_triples "."? triples_template?)*

// [53] QuadsNotTriples ::= 'GRAPH' VarOrIri '{' TriplesTemplate? '}'
quads_not_triples: "GRAPH"i var_or_iri "{" triples_template? "}"

// [54] TriplesTemplate ::= TriplesSameSubject ( '.' TriplesTemplate? )?
triples_template: triples_same_subject ("." triples_template?)?


// =============================================================================
// Graph patterns, filters, function calls  [55]-[78]
// =============================================================================

// [55] GroupGraphPattern ::= '{' ( SubSelect | GroupGraphPatternSub ) '}'
group_graph_pattern: "{" (sub_select | group_graph_pattern_sub) "}"

// [56] GroupGraphPatternSub ::= TriplesBlock? ( GraphPatternNotTriples '.'? TriplesBlock? )*
group_graph_pattern_sub: triples_block? (graph_pattern_not_triples "."? triples_block?)*

// [57] TriplesBlock ::= TriplesSameSubjectPath ( '.' TriplesBlock? )?
triples_block: triples_same_subject_path ("." triples_block?)?

// [58] ReifiedTripleBlock ::= ReifiedTriple PropertyList
reified_triple_block: reified_triple property_list

// [59] ReifiedTripleBlockPath ::= ReifiedTriple PropertyListPath
reified_triple_block_path: reified_triple property_list_path

// [60] GraphPatternNotTriples ::= GroupOrUnionGraphPattern | OptionalGraphPattern | MinusGraphPattern | GraphGraphPattern | ServiceGraphPattern | Filter | Bind | InlineData
graph_pattern_not_triples: group_or_union_graph_pattern
                         | optional_graph_pattern
                         | minus_graph_pattern
                         | graph_graph_pattern
                         | service_graph_pattern
                         | filter
                         | bind
                         | inline_data

// [61] OptionalGraphPattern ::= 'OPTIONAL' GroupGraphPattern
optional_graph_pattern: "OPTIONAL"i group_graph_pattern

// [62] GraphGraphPattern ::= 'GRAPH' VarOrIri GroupGraphPattern
graph_graph_pattern: "GRAPH"i var_or_iri group_graph_pattern

// [63] ServiceGraphPattern ::= 'SERVICE' 'SILENT'? VarOrIri GroupGraphPattern
service_graph_pattern: "SERVICE"i "SILENT"i? var_or_iri group_graph_pattern

// [64] Bind ::= 'BIND' '(' Expression 'AS' Var ')'
bind: "BIND"i "(" expression "AS"i var ")"

// [65] InlineData ::= 'VALUES' DataBlock
inline_data: "VALUES"i data_block

// [66] DataBlock ::= InlineDataOneVar | InlineDataFull
data_block: inline_data_one_var | inline_data_full

// [67] InlineDataOneVar ::= Var '{' DataBlockValue* '}'
inline_data_one_var: var "{" data_block_value* "}"

// [68] InlineDataFull ::= ( NIL | '(' Var* ')' ) '{' ( '(' DataBlockValue* ')' | NIL )* '}'
inline_data_full: (NIL | "(" var* ")") "{" ("(" data_block_value* ")" | NIL)* "}"

// [69] DataBlockValue ::= iri | RDFLiteral | NumericLiteral | BooleanLiteral | 'UNDEF' | TripleTermData
data_block_value: iri
                | rdf_literal
                | numeric_literal
                | boolean_literal
                | "UNDEF"i
                | triple_term_data

// [70] Reifier ::= '~' VarOrReifierId?
reifier: "~" var_or_reifier_id?

// [71] VarOrReifierId ::= Var | iri | BlankNode
var_or_reifier_id: var | iri | blank_node

// [72] MinusGraphPattern ::= 'MINUS' GroupGraphPattern
minus_graph_pattern: "MINUS"i group_graph_pattern

// [73] GroupOrUnionGraphPattern ::= GroupGraphPattern ( 'UNION' GroupGraphPattern )*
group_or_union_graph_pattern: group_graph_pattern ("UNION"i group_graph_pattern)*

// [74] Filter ::= 'FILTER' Constraint
filter: "FILTER"i constraint

// [75] Constraint ::= BrackettedExpression | BuiltInCall | FunctionCall
constraint: bracketted_expression | built_in_call | function_call

// [76] FunctionCall ::= iri ArgList
function_call: iri arg_list

// [77] ArgList ::= NIL | '(' 'DISTINCT'? Expression ( ',' Expression )* ')'
arg_list: NIL | "(" "DISTINCT"i? expression ("," expression)* ")"

// [78] ExpressionList ::= NIL | '(' Expression ( ',' Expression )* ')'
expression_list: NIL | "(" expression ("," expression)* ")"


// =============================================================================
// Triples, property paths, reification and triple terms  [79]-[126]
// =============================================================================

// [79] ConstructTemplate ::= '{' ConstructTriples? '}'
construct_template: "{" construct_triples? "}"

// [80] ConstructTriples ::= TriplesSameSubject ( '.' ConstructTriples? )?
construct_triples: triples_same_subject ("." construct_triples?)?

// [81] TriplesSameSubject ::= VarOrTerm PropertyListNotEmpty | TriplesNode PropertyList | ReifiedTripleBlock
triples_same_subject: var_or_term property_list_not_empty
                    | triples_node property_list
                    | reified_triple_block

// [82] PropertyList ::= PropertyListNotEmpty?
property_list: property_list_not_empty?

// [83] PropertyListNotEmpty ::= Verb ObjectList ( ';' ( Verb ObjectList )? )*
property_list_not_empty: verb object_list (";" (verb object_list)?)*

// [84] Verb ::= VarOrIri | 'a'
verb: var_or_iri | "a"

// [85] ObjectList ::= Object ( ',' Object )*
object_list: object ("," object)*

// [86] Object ::= GraphNode Annotation
object: graph_node annotation

// [87] TriplesSameSubjectPath ::= VarOrTerm PropertyListPathNotEmpty | TriplesNodePath PropertyListPath | ReifiedTripleBlockPath
triples_same_subject_path: var_or_term property_list_path_not_empty
                         | triples_node_path property_list_path
                         | reified_triple_block_path

// [88] PropertyListPath ::= PropertyListPathNotEmpty?
property_list_path: property_list_path_not_empty?

// [89] PropertyListPathNotEmpty ::= ( VerbPath | VerbSimple ) ObjectListPath ( ';' ( ( VerbPath | VerbSimple ) ObjectListPath )? )*
property_list_path_not_empty: (verb_path
                            | verb_simple) object_list_path (";" ((verb_path | verb_simple) object_list_path)?)*

// [90] VerbPath ::= Path
verb_path: path

// [91] VerbSimple ::= Var
verb_simple: var

// [92] ObjectListPath ::= ObjectPath ( ',' ObjectPath )*
object_list_path: object_path ("," object_path)*

// [93] ObjectPath ::= GraphNodePath AnnotationPath
object_path: graph_node_path annotation_path

// [94] Path ::= PathAlternative
path: path_alternative

// [95] PathAlternative ::= PathSequence ( '|' PathSequence )*
path_alternative: path_sequence ("|" path_sequence)*

// [96] PathSequence ::= PathEltOrInverse ( '/' PathEltOrInverse )*
path_sequence: path_elt_or_inverse ("/" path_elt_or_inverse)*

// [97] PathElt ::= PathPrimary PathMod?
path_elt: path_primary path_mod?

// [98] PathEltOrInverse ::= PathElt | '^' PathElt
path_elt_or_inverse: path_elt | "^" path_elt

// [99] PathMod ::= '?' | '*' | '+'
path_mod: "?" | "*" | "+"

// [100] PathPrimary ::= iri | 'a' | '!' PathNegatedPropertySet | '(' Path ')'
path_primary: iri | "a" | "!" path_negated_property_set | "(" path ")"

// [101] PathNegatedPropertySet ::= PathOneInPropertySet | '(' ( PathOneInPropertySet ( '|' PathOneInPropertySet )* )? ')'
path_negated_property_set: path_one_in_property_set
                         | "(" (path_one_in_property_set ("|" path_one_in_property_set)*)? ")"

// [102] PathOneInPropertySet ::= iri | 'a' | '^' ( iri | 'a' )
path_one_in_property_set: iri | "a" | "^" (iri | "a")

// [103] TriplesNode ::= Collection | BlankNodePropertyList
triples_node: collection | blank_node_property_list

// [104] BlankNodePropertyList ::= '[' PropertyListNotEmpty ']'
blank_node_property_list: "[" property_list_not_empty "]"

// [105] TriplesNodePath ::= CollectionPath | BlankNodePropertyListPath
triples_node_path: collection_path | blank_node_property_list_path

// [106] BlankNodePropertyListPath ::= '[' PropertyListPathNotEmpty ']'
blank_node_property_list_path: "[" property_list_path_not_empty "]"

// [107] Collection ::= '(' GraphNode+ ')'
collection: "(" graph_node+ ")"

// [108] CollectionPath ::= '(' GraphNodePath+ ')'
collection_path: "(" graph_node_path+ ")"

// [109] AnnotationPath ::= ( Reifier | AnnotationBlockPath )*
annotation_path: (reifier | annotation_block_path)*

// [110] AnnotationBlockPath ::= '{|' PropertyListPathNotEmpty '|}'
annotation_block_path: "{|" property_list_path_not_empty "|}"

// [111] Annotation ::= ( Reifier | AnnotationBlock )*
annotation: (reifier | annotation_block)*

// [112] AnnotationBlock ::= '{|' PropertyListNotEmpty '|}'
annotation_block: "{|" property_list_not_empty "|}"

// [113] GraphNode ::= VarOrTerm | TriplesNode | ReifiedTriple
graph_node: var_or_term | triples_node | reified_triple

// [114] GraphNodePath ::= VarOrTerm | TriplesNodePath | ReifiedTriple
graph_node_path: var_or_term | triples_node_path | reified_triple

// [115] VarOrTerm ::= Var | iri | RDFLiteral | NumericLiteral | BooleanLiteral | BlankNode | NIL | TripleTerm
var_or_term: var
           | iri
           | rdf_literal
           | numeric_literal
           | boolean_literal
           | blank_node
           | NIL
           | triple_term

// [116] ReifiedTriple ::= '<<' ReifiedTripleSubject Verb ReifiedTripleObject Reifier? '>>'
reified_triple: "<<" reified_triple_subject verb reified_triple_object reifier? ">>"

// [117] ReifiedTripleSubject ::= Var | iri | RDFLiteral | NumericLiteral | BooleanLiteral | BlankNode | ReifiedTriple | TripleTerm
reified_triple_subject: var
                      | iri
                      | rdf_literal
                      | numeric_literal
                      | boolean_literal
                      | blank_node
                      | reified_triple
                      | triple_term

// [118] ReifiedTripleObject ::= Var | iri | RDFLiteral | NumericLiteral | BooleanLiteral | BlankNode | ReifiedTriple | TripleTerm
reified_triple_object: var
                     | iri
                     | rdf_literal
                     | numeric_literal
                     | boolean_literal
                     | blank_node
                     | reified_triple
                     | triple_term

// [119] TripleTerm ::= '<<(' TripleTermSubject Verb TripleTermObject ')>>'
triple_term: "<<(" triple_term_subject verb triple_term_object ")>>"

// [120] TripleTermSubject ::= Var | iri | RDFLiteral | NumericLiteral | BooleanLiteral | BlankNode | TripleTerm
triple_term_subject: var
                   | iri
                   | rdf_literal
                   | numeric_literal
                   | boolean_literal
                   | blank_node
                   | triple_term

// [121] TripleTermObject ::= Var | iri | RDFLiteral | NumericLiteral | BooleanLiteral | BlankNode | TripleTerm
triple_term_object: var
                  | iri
                  | rdf_literal
                  | numeric_literal
                  | boolean_literal
                  | blank_node
                  | triple_term

// [122] TripleTermData ::= '<<(' TripleTermDataSubject ( iri | 'a' ) TripleTermDataObject ')>>'
triple_term_data: "<<(" triple_term_data_subject (iri | "a") triple_term_data_object ")>>"

// [123] TripleTermDataSubject ::= iri
triple_term_data_subject: iri

// [124] TripleTermDataObject ::= iri | RDFLiteral | NumericLiteral | BooleanLiteral | TripleTermData
triple_term_data_object: iri | rdf_literal | numeric_literal | boolean_literal | triple_term_data

// [125] VarOrIri ::= Var | iri
var_or_iri: var | iri

// [126] Var ::= VAR1 | VAR2
var: VAR1 | VAR2


// =============================================================================
// Expressions, built-in functions and literals  [127]-[158]
// =============================================================================

// [127] Expression ::= ConditionalOrExpression
expression: conditional_or_expression

// [128] ConditionalOrExpression ::= ConditionalAndExpression ( '||' ConditionalAndExpression )*
conditional_or_expression: conditional_and_expression ("||" conditional_and_expression)*

// [129] ConditionalAndExpression ::= ValueLogical ( '&&' ValueLogical )*
conditional_and_expression: value_logical ("&&" value_logical)*

// [130] ValueLogical ::= RelationalExpression
value_logical: relational_expression

// [131] RelationalExpression ::= NumericExpression ( '=' NumericExpression | '!=' NumericExpression | '<' NumericExpression | '>' NumericExpression | '<=' NumericExpression | '>=' NumericExpression | 'IN' ExpressionList | 'NOT' 'IN' ExpressionList )?
relational_expression: numeric_expression ("=" numeric_expression
                     | "!=" numeric_expression
                     | "<" numeric_expression
                     | ">" numeric_expression
                     | "<=" numeric_expression
                     | ">=" numeric_expression
                     | "IN"i expression_list
                     | "NOT"i "IN"i expression_list)?

// [132] NumericExpression ::= AdditiveExpression
numeric_expression: additive_expression

// [133] AdditiveExpression ::= MultiplicativeExpression ( '+' MultiplicativeExpression | '-' MultiplicativeExpression | ( NumericLiteralPositive | NumericLiteralNegative ) ( ( '*' UnaryExpression ) | ( '/' UnaryExpression ) )* )*
additive_expression: multiplicative_expression ("+" multiplicative_expression
                   | "-" multiplicative_expression
                   | (numeric_literal_positive | numeric_literal_negative) (("*" unary_expression) | ("/" unary_expression))*)*

// [134] MultiplicativeExpression ::= UnaryExpression ( '*' UnaryExpression | '/' UnaryExpression )*
multiplicative_expression: unary_expression ("*" unary_expression | "/" unary_expression)*

// [135] UnaryExpression ::= '!' UnaryExpression
//       |   '+' PrimaryExpression
//       |   '-' PrimaryExpression
//       |   PrimaryExpression
unary_expression: "!" unary_expression
                | "+" primary_expression
                | "-" primary_expression
                | primary_expression

// [136] PrimaryExpression ::= BrackettedExpression | BuiltInCall | iriOrFunction | RDFLiteral | NumericLiteral | BooleanLiteral | Var | ExprTripleTerm
primary_expression: bracketted_expression
                  | built_in_call
                  | iri_or_function
                  | rdf_literal
                  | numeric_literal
                  | boolean_literal
                  | var
                  | expr_triple_term

// [137] ExprTripleTerm ::= '<<(' ExprTripleTermSubject Verb ExprTripleTermObject ')>>'
expr_triple_term: "<<(" expr_triple_term_subject verb expr_triple_term_object ")>>"

// [138] ExprTripleTermSubject ::= iri | Var
expr_triple_term_subject: iri | var

// [139] ExprTripleTermObject ::= iri | RDFLiteral | NumericLiteral | BooleanLiteral | Var | ExprTripleTerm
expr_triple_term_object: iri
                       | rdf_literal
                       | numeric_literal
                       | boolean_literal
                       | var
                       | expr_triple_term

// [140] BrackettedExpression ::= '(' Expression ')'
bracketted_expression: "(" expression ")"

// [141] BuiltInCall ::= Aggregate
//       |   'STR' '(' Expression ')'
//       |   'LANG' '(' Expression ')'
//       |   'LANGMATCHES' '(' Expression ',' Expression ')'
//       |   'LANGDIR' '(' Expression ')'
//       |   'DATATYPE' '(' Expression ')'
//       |   'BOUND' '(' Var ')'
//       |   'IRI' '(' Expression ')'
//       |   'URI' '(' Expression ')'
//       |   'BNODE' ( '(' Expression ')' | NIL )
//       |   'RAND' NIL
//       |   'ABS' '(' Expression ')'
//       |   'CEIL' '(' Expression ')'
//       |   'FLOOR' '(' Expression ')'
//       |   'ROUND' '(' Expression ')'
//       |   'CONCAT' ExpressionList
//       |   SubstringExpression
//       |   'STRLEN' '(' Expression ')'
//       |   StrReplaceExpression
//       |   'UCASE' '(' Expression ')'
//       |   'LCASE' '(' Expression ')'
//       |   'ENCODE_FOR_URI' '(' Expression ')'
//       |   'CONTAINS' '(' Expression ',' Expression ')'
//       |   'STRSTARTS' '(' Expression ',' Expression ')'
//       |   'STRENDS' '(' Expression ',' Expression ')'
//       |   'STRBEFORE' '(' Expression ',' Expression ')'
//       |   'STRAFTER' '(' Expression ',' Expression ')'
//       |   'YEAR' '(' Expression ')'
//       |   'MONTH' '(' Expression ')'
//       |   'DAY' '(' Expression ')'
//       |   'HOURS' '(' Expression ')'
//       |   'MINUTES' '(' Expression ')'
//       |   'SECONDS' '(' Expression ')'
//       |   'TIMEZONE' '(' Expression ')'
//       |   'TZ' '(' Expression ')'
//       |   'NOW' NIL
//       |   'UUID' NIL
//       |   'STRUUID' NIL
//       |   'MD5' '(' Expression ')'
//       |   'SHA1' '(' Expression ')'
//       |   'SHA256' '(' Expression ')'
//       |   'SHA384' '(' Expression ')'
//       |   'SHA512' '(' Expression ')'
//       |   'COALESCE' ExpressionList
//       |   'IF' '(' Expression ',' Expression ',' Expression ')'
//       |   'STRLANG' '(' Expression ',' Expression ')'
//       |   'STRLANGDIR' '(' Expression ',' Expression ',' Expression ')'
//       |   'STRDT' '(' Expression ',' Expression ')'
//       |   'sameTerm' '(' Expression ',' Expression ')'
//       |   'isIRI' '(' Expression ')'
//       |   'isURI' '(' Expression ')'
//       |   'isBLANK' '(' Expression ')'
//       |   'isLITERAL' '(' Expression ')'
//       |   'isNUMERIC' '(' Expression ')'
//       |   'hasLANG' '(' Expression ')'
//       |   'hasLANGDIR' '(' Expression ')'
//       |   RegexExpression
//       |   ExistsFunc
//       |   NotExistsFunc
//       |   'isTRIPLE' '(' Expression ')'
//       |   'TRIPLE' '(' Expression ',' Expression ',' Expression ')'
//       |   'SUBJECT' '(' Expression ')'
//       |   'PREDICATE' '(' Expression ')'
//       |   'OBJECT' '(' Expression ')'
built_in_call: aggregate
             | "STR"i "(" expression ")"
             | "LANG"i "(" expression ")"
             | "LANGMATCHES"i "(" expression "," expression ")"
             | "LANGDIR"i "(" expression ")"
             | "DATATYPE"i "(" expression ")"
             | "BOUND"i "(" var ")"
             | "IRI"i "(" expression ")"
             | "URI"i "(" expression ")"
             | "BNODE"i ("(" expression ")" | NIL)
             | "RAND"i NIL
             | "ABS"i "(" expression ")"
             | "CEIL"i "(" expression ")"
             | "FLOOR"i "(" expression ")"
             | "ROUND"i "(" expression ")"
             | "CONCAT"i expression_list
             | substring_expression
             | "STRLEN"i "(" expression ")"
             | str_replace_expression
             | "UCASE"i "(" expression ")"
             | "LCASE"i "(" expression ")"
             | "ENCODE_FOR_URI"i "(" expression ")"
             | "CONTAINS"i "(" expression "," expression ")"
             | "STRSTARTS"i "(" expression "," expression ")"
             | "STRENDS"i "(" expression "," expression ")"
             | "STRBEFORE"i "(" expression "," expression ")"
             | "STRAFTER"i "(" expression "," expression ")"
             | "YEAR"i "(" expression ")"
             | "MONTH"i "(" expression ")"
             | "DAY"i "(" expression ")"
             | "HOURS"i "(" expression ")"
             | "MINUTES"i "(" expression ")"
             | "SECONDS"i "(" expression ")"
             | "TIMEZONE"i "(" expression ")"
             | "TZ"i "(" expression ")"
             | "NOW"i NIL
             | "UUID"i NIL
             | "STRUUID"i NIL
             | "MD5"i "(" expression ")"
             | "SHA1"i "(" expression ")"
             | "SHA256"i "(" expression ")"
             | "SHA384"i "(" expression ")"
             | "SHA512"i "(" expression ")"
             | "COALESCE"i expression_list
             | "IF"i "(" expression "," expression "," expression ")"
             | "STRLANG"i "(" expression "," expression ")"
             | "STRLANGDIR"i "(" expression "," expression "," expression ")"
             | "STRDT"i "(" expression "," expression ")"
             | "sameTerm"i "(" expression "," expression ")"
             | "isIRI"i "(" expression ")"
             | "isURI"i "(" expression ")"
             | "isBLANK"i "(" expression ")"
             | "isLITERAL"i "(" expression ")"
             | "isNUMERIC"i "(" expression ")"
             | "hasLANG"i "(" expression ")"
             | "hasLANGDIR"i "(" expression ")"
             | regex_expression
             | exists_func
             | not_exists_func
             | "isTRIPLE"i "(" expression ")"
             | "TRIPLE"i "(" expression "," expression "," expression ")"
             | "SUBJECT"i "(" expression ")"
             | "PREDICATE"i "(" expression ")"
             | "OBJECT"i "(" expression ")"

// [142] RegexExpression ::= 'REGEX' '(' Expression ',' Expression ( ',' Expression )? ')'
regex_expression: "REGEX"i "(" expression "," expression ("," expression)? ")"

// [143] SubstringExpression ::= 'SUBSTR' '(' Expression ',' Expression ( ',' Expression )? ')'
substring_expression: "SUBSTR"i "(" expression "," expression ("," expression)? ")"

// [144] StrReplaceExpression ::= 'REPLACE' '(' Expression ',' Expression ',' Expression ( ',' Expression )? ')'
str_replace_expression: "REPLACE"i "(" expression "," expression "," expression ("," expression)? ")"

// [145] ExistsFunc ::= 'EXISTS' GroupGraphPattern
exists_func: "EXISTS"i group_graph_pattern

// [146] NotExistsFunc ::= 'NOT' 'EXISTS' GroupGraphPattern
not_exists_func: "NOT"i "EXISTS"i group_graph_pattern

// [147] Aggregate ::= ( 'COUNT' '(' 'DISTINCT'? ( '*'
//       |   Expression ) ')'
//       |   'SUM' '(' 'DISTINCT'? Expression ')'
//       |   'MIN' '(' 'DISTINCT'? Expression ')'
//       |   'MAX' '(' 'DISTINCT'? Expression ')'
//       |   'AVG' '(' 'DISTINCT'? Expression ')'
//       |   'SAMPLE' '(' 'DISTINCT'? Expression ')'
//       |   'GROUP_CONCAT' '(' 'DISTINCT'? Expression ( ';' 'SEPARATOR' '=' String )? ')' )
aggregate: ("COUNT"i "(" "DISTINCT"i? ("*" | expression) ")"
         | "SUM"i "(" "DISTINCT"i? expression ")"
         | "MIN"i "(" "DISTINCT"i? expression ")"
         | "MAX"i "(" "DISTINCT"i? expression ")"
         | "AVG"i "(" "DISTINCT"i? expression ")"
         | "SAMPLE"i "(" "DISTINCT"i? expression ")"
         | "GROUP_CONCAT"i "(" "DISTINCT"i? expression (";" "SEPARATOR"i "=" string)? ")")

// [148] iriOrFunction ::= iri ArgList?
iri_or_function: iri arg_list?

// [149] RDFLiteral ::= String ( LANG_DIR | '^^' iri )?
rdf_literal: string (LANG_DIR | "^^" iri)?

// [150] NumericLiteral ::= NumericLiteralUnsigned | NumericLiteralPositive | NumericLiteralNegative
numeric_literal: numeric_literal_unsigned | numeric_literal_positive | numeric_literal_negative

// [151] NumericLiteralUnsigned ::= INTEGER | DECIMAL | DOUBLE
numeric_literal_unsigned: INTEGER | DECIMAL | DOUBLE

// [152] NumericLiteralPositive ::= INTEGER_POSITIVE | DECIMAL_POSITIVE | DOUBLE_POSITIVE
numeric_literal_positive: INTEGER_POSITIVE | DECIMAL_POSITIVE | DOUBLE_POSITIVE

// [153] NumericLiteralNegative ::= INTEGER_NEGATIVE | DECIMAL_NEGATIVE | DOUBLE_NEGATIVE
numeric_literal_negative: INTEGER_NEGATIVE | DECIMAL_NEGATIVE | DOUBLE_NEGATIVE

// [154] BooleanLiteral ::= 'true' | 'false'
boolean_literal: "true"i | "false"i

// [155] String ::= STRING_LITERAL1 | STRING_LITERAL2 | STRING_LITERAL_LONG1 | STRING_LITERAL_LONG2
string: STRING_LITERAL1 | STRING_LITERAL2 | STRING_LITERAL_LONG1 | STRING_LITERAL_LONG2

// [156] iri ::= IRIREF | PrefixedName
iri: IRIREF | prefixed_name

// [157] PrefixedName ::= PNAME_LN | PNAME_NS
prefixed_name: PNAME_LN | PNAME_NS

// [158] BlankNode ::= BLANK_NODE_LABEL | ANON
blank_node: BLANK_NODE_LABEL | ANON


// =============================================================================
// Terminals  [159]-[194]
// =============================================================================
//
// General note on termainal matching:
// 19.7 Grammar, Note 3 states: "When tokenizing the input and choosing grammar rules, the longest match is chosen."
// In Lark, longest match behavior can be achieved by using Terminal Priority,
// see https://lark-parser.readthedocs.io/en/latest/grammar.html#priority.


// [159] IRIREF ::= '<' ( [^<>"{}|^`\]-[#x00-#x20] | UCHAR ) * '>'
IRIREF: "<" (/[^<>"{}|^`\\\x00-\x20]/ | UCHAR)* ">"

// [160] PNAME_NS ::= PN_PREFIX? ':'
PNAME_NS: PN_PREFIX? ":"

// [161] PNAME_LN ::= PNAME_NS PN_LOCAL
// Priority 1: every PNAME_LN starts with something that is also a PNAME_NS
// ("ex:" in "ex:foo"), so PNAME_LN must be tried first (longest match).
PNAME_LN.1: PNAME_NS PN_LOCAL

// [162] BLANK_NODE_LABEL ::= '_:' ( PN_CHARS_U | [0-9] ) ((PN_CHARS|'.')* PN_CHARS)?
BLANK_NODE_LABEL: "_:" (PN_CHARS_U | "0".."9") ((PN_CHARS | ".")* PN_CHARS)?

// [163] VAR1 ::= '?' VARNAME
VAR1: "?" VARNAME

// [164] VAR2 ::= '$' VARNAME
VAR2: "$" VARNAME

// [165] LANG_DIR ::= '@' [a-zA-Z]+ ('-' [a-zA-Z0-9]+)* ('--' [a-zA-Z]+)?
LANG_DIR: "@" ("a".."z" | "A".."Z")+ ("-" ("a".."z" | "A".."Z" | "0".."9")+)* ("--" ("a".."z" | "A".."Z")+)?

// [166] INTEGER ::= [0-9]+
INTEGER: ("0".."9")+

// [167] DECIMAL ::= [0-9]* '.' [0-9]+
// Priorities for numbers: DOUBLE (2) before DECIMAL (1) before INTEGER (0).
// "1.5e3" must not stop at "1.5" or "1"; "1.5" must not stop at "1".
DECIMAL.1: ("0".."9")* "." ("0".."9")+

// [168] DOUBLE ::= ( ([0-9]+ ('.'[0-9]*)? ) | ( '.' ([0-9])+ ) ) EXPONENT
DOUBLE.2: ((("0".."9")+ ("." ("0".."9")*)?) | ("." ("0".."9")+)) EXPONENT

// [169] EXPONENT ::= [eE] [+-]? [0-9]+
EXPONENT: ("e" | "E") ("+" | "-")? ("0".."9")+

// [170] INTEGER_POSITIVE ::= '+' INTEGER
INTEGER_POSITIVE: "+" INTEGER

// [171] DECIMAL_POSITIVE ::= '+' DECIMAL
DECIMAL_POSITIVE.1: "+" DECIMAL

// [172] DOUBLE_POSITIVE ::= '+' DOUBLE
DOUBLE_POSITIVE.2: "+" DOUBLE

// [173] INTEGER_NEGATIVE ::= '-' INTEGER
INTEGER_NEGATIVE: "-" INTEGER

// [174] DECIMAL_NEGATIVE ::= '-' DECIMAL
DECIMAL_NEGATIVE.1: "-" DECIMAL

// [175] DOUBLE_NEGATIVE ::= '-' DOUBLE
DOUBLE_NEGATIVE.2: "-" DOUBLE

// [176] STRING_LITERAL1 ::= "'" ( ([^#x27#x5C#xA#xD]) | ECHAR | UCHAR )* "'"
// Regex for the spec's 'anything except' class. Write \\ and \n \r here, not
// \x5C \x0A \x0D: Lark turns \x5C into a real backslash *before* compiling,
// which would then escape the next character of the class.
STRING_LITERAL1: "'" (/[^'\\\n\r]/ | ECHAR | UCHAR)* "'"

// [177] STRING_LITERAL2 ::= '"' ( ([^#x22#x5C#xA#xD]) | ECHAR | UCHAR )* '"'
STRING_LITERAL2: "\"" (/[^"\\\n\r]/ | ECHAR | UCHAR)* "\""

// [178] STRING_LITERAL_LONG1 ::= "'''" ( ( "'" | "''" )? ( [^'\] | ECHAR | UCHAR ) )* "'''"
// Priority 1 for the long forms: ''' must not lex as the empty string '' followed by '.
STRING_LITERAL_LONG1.1: "'''" (("'" | "''")? (/[^'\\]/ | ECHAR | UCHAR))* "'''"

// [179] STRING_LITERAL_LONG2 ::= '"""' ( ( '"' | '""' )? ( [^"\] | ECHAR | UCHAR ) )* '"""'
STRING_LITERAL_LONG2.1: "\"\"\"" (("\"" | "\"\"")? (/[^"\\]/ | ECHAR | UCHAR))* "\"\"\""

// [180] ECHAR ::= '\' [tbnrf\"']
ECHAR: "\\" ("t" | "b" | "n" | "r" | "f" | "\\" | "\"" | "'")

// [181] UCHAR ::= ('\u' HEX HEX HEX HEX) | ('\U' HEX HEX HEX HEX HEX HEX HEX HEX)
UCHAR: ("\\u" HEX HEX HEX HEX) | ("\\U" HEX HEX HEX HEX HEX HEX HEX HEX)

// [182] NIL ::= '(' WS* ')'
NIL: "(" WS* ")"

// [183] WS ::= #x20 | #x9 | #xD | #xA
WS: "\x20" | "\x09" | "\x0D" | "\x0A"

// [184] ANON ::= '['  WS* ']'
ANON: "[" WS* "]"

// [185] PN_CHARS_BASE ::= [A-Z]
//       |   [a-z]
//       |   [#x00C0-#x00D6]
//       |   [#x00D8-#x00F6]
//       |   [#x00F8-#x02FF]
//       |   [#x0370-#x037D]
//       |   [#x037F-#x1FFF]
//       |   [#x200C-#x200D]
//       |   [#x2070-#x218F]
//       |   [#x2C00-#x2FEF]
//       |   [#x3001-#xD7FF]
//       |   [#xF900-#xFDCF]
//       |   [#xFDF0-#xFFFD]
//       |   [#x10000-#xEFFFF]
PN_CHARS_BASE: "A".."Z"
             | "a".."z"
             | "\u00C0".."\u00D6"
             | "\u00D8".."\u00F6"
             | "\u00F8".."\u02FF"
             | "\u0370".."\u037D"
             | "\u037F".."\u1FFF"
             | "\u200C".."\u200D"
             | "\u2070".."\u218F"
             | "\u2C00".."\u2FEF"
             | "\u3001".."\uD7FF"
             | "\uF900".."\uFDCF"
             | "\uFDF0".."\uFFFD"
             | "\U00010000".."\U000EFFFF"

// [186] PN_CHARS_U ::= PN_CHARS_BASE | '_'
PN_CHARS_U: PN_CHARS_BASE | "_"

// [187] VARNAME ::= ( PN_CHARS_U  | [0-9] ) ( PN_CHARS_U | [0-9] | #x00B7 | [#x0300-#x036F] | [#x203F-#x2040] )*
VARNAME: (PN_CHARS_U | "0".."9") (PN_CHARS_U | "0".."9" | "\u00B7" | "\u0300".."\u036F" | "\u203F".."\u2040")*

// [188] PN_CHARS ::= PN_CHARS_U | '-' | [0-9] | #x00B7 | [#x0300-#x036F] | [#x203F-#x2040]
PN_CHARS: PN_CHARS_U | "-" | "0".."9" | "\u00B7" | "\u0300".."\u036F" | "\u203F".."\u2040"

// [189] PN_PREFIX ::= PN_CHARS_BASE ((PN_CHARS|'.')* PN_CHARS)?
PN_PREFIX: PN_CHARS_BASE ((PN_CHARS | ".")* PN_CHARS)?

// [190] PN_LOCAL ::= (PN_CHARS_U | ':' | [0-9] | PLX ) ((PN_CHARS | '.' | ':' | PLX)* (PN_CHARS | ':' | PLX) )?
PN_LOCAL: (PN_CHARS_U | ":" | "0".."9" | PLX) ((PN_CHARS | "." | ":" | PLX)* (PN_CHARS | ":" | PLX))?

// [191] PLX ::= PERCENT | PN_LOCAL_ESC
PLX: PERCENT | PN_LOCAL_ESC

// [192] PERCENT ::= '%' HEX HEX
PERCENT: "%" HEX HEX

// [193] HEX ::= [0-9] | [A-F] | [a-f]
HEX: "0".."9" | "A".."F" | "a".."f"

// [194] PN_LOCAL_ESC ::= '\' ( '_' | '~' | '.' | '-' | '!' | '$' | '&' | "'" | '(' | ')' | '*' | '+' | ',' | ';' | '=' | '/' | '?' | '#' | '@' | '%' )
PN_LOCAL_ESC: "\\" ("_" | "~" | "." | "-" | "!" | "$" | "&" | "'" | "(" | ")" | "*" | "+" | "," | ";" | "=" | "/" | "?" | "#" | "@" | "%")


// =============================================================================
// White space and comments (spec sections 19.3 and 19.4; not productions)
// =============================================================================

COMMENT: "#" /[^\r\n]/*

// White space and comments may appear between any two tokens, and are dropped.
%ignore WS
%ignore COMMENT
